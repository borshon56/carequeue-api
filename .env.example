# Copy to .env and fill in your own LOCAL values. Never commit .env.
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=carequeue

# JWT (use a long random string, at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Doctor slots: default slot length in minutes for POST /slots/generate
SLOT_DURATION_MINUTES=30

# First admin account, created by: npm run seed:admin
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@carequeue.local
ADMIN_PASSWORD=change_me_to_a_strong_password